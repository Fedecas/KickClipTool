{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-temp-read-recursive",
      "allow": [{ "path": "$TEMP/KickClipTool/**" }]
    },
    {
      "identifier": "fs:allow-temp-write-recursive",
      "allow": [{ "path": "$TEMP/KickClipTool/**" }]
    },
    "shell:allow-spawn"
  ]
}
